// VitalFlow — schema
// Design reference: docs/DATA_MODEL.md
// STATUS: pre-migration. Expect the first migration once the math foundation lands.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships  Membership[]
  sessions     Session[]
  accounts     Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(owner)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Organization {
  id              String   @id @default(cuid())
  name            String
  country         String?  // ISO 3166-1 alpha-2
  defaultCurrency String   // ISO 4217
  sector          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statements  Statement[]
  analyses    Analysis[]
  auditLogs   AuditLog[]
  memberships Membership[]
  counterparties Counterparty[]
}

// ---------------------------------------------------------------------------
// Statements & transactions
// ---------------------------------------------------------------------------

model Statement {
  id                 String          @id @default(cuid())
  organizationId     String
  filename           String
  fileRef            String // object storage key — never a public path
  sizeBytes          Int
  checksum           String
  status             StatementStatus @default(uploaded)
  currency           String?
  periodStart        DateTime?
  periodEnd          DateTime?
  columnMapping      Json?
  hasBalanceColumn   Boolean         @default(false)
  qualityReport      Json?
  retentionExpiresAt DateTime?
  supersedesId       String?
  createdAt          DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  analyses     Analysis[]

  @@index([organizationId, createdAt])
  @@index([checksum])
}

model Transaction {
  id                    String          @id @default(cuid())
  statementId           String
  organizationId        String // denormalised for query scoping
  date                  DateTime        @db.Date
  description           String
  normalizedDescription String
  amountMinor           BigInt // signed integer minor units; positive = inflow
  currency              String
  balanceMinor          BigInt?
  direction             Direction
  category              String?
  categorySource        CategorySource?
  counterpartyId        String?
  isTransfer            Boolean         @default(false)
  isRecurring           Boolean         @default(false)
  recurringSeriesId     String?
  rowNumber             Int

  statement    Statement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  counterparty Counterparty?   @relation(fields: [counterpartyId], references: [id])
  series       RecurringSeries? @relation(fields: [recurringSeriesId], references: [id])

  @@index([organizationId, date])
  @@index([statementId, date])
  @@index([counterpartyId])
  @@index([recurringSeriesId])
}

model Counterparty {
  id                String           @id @default(cuid())
  organizationId    String
  displayName       String
  normalizedKey     String
  type              CounterpartyType @default(unknown)
  totalInflowMinor  BigInt           @default(0)
  totalOutflowMinor BigInt           @default(0)
  transactionCount  Int              @default(0)
  firstSeen         DateTime?        @db.Date
  lastSeen          DateTime?        @db.Date

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([organizationId, normalizedKey])
}

model RecurringSeries {
  id                String   @id @default(cuid())
  analysisId        String
  label             String
  direction         Direction
  cadence           Cadence
  medianAmountMinor BigInt
  amountVariance    Float
  confidence        Float
  isActive          Boolean  @default(true)
  isFixedObligation Boolean  @default(false)

  analysis     Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([analysisId])
}

// ---------------------------------------------------------------------------
// Analysis
// ---------------------------------------------------------------------------

model Analysis {
  id                  String         @id @default(cuid())
  organizationId      String
  statementId         String
  status              AnalysisStatus @default(queued)
  stage               String?
  progressPercent     Int            @default(0)
  score               Int?
  band                HealthBand?
  pillars             Json?
  confidence          Float?
  fundingTier         FundingTier?
  scoringVersion      String         @default("scoring@0.1.0")
  degraded            Boolean        @default(false)
  failureCode         String?
  failureMessage      String?
  totalTokens         Int            @default(0)
  estimatedCostMicros BigInt         @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statement       Statement         @relation(fields: [statementId], references: [id], onDelete: Cascade)
  agentRuns       AgentRun[]
  metrics         Metric[]
  insights        Insight[]
  recommendations Recommendation[]
  riskFlags       RiskFlag[]
  recurringSeries RecurringSeries[]
  report          Report?
  fundingOutreaches FundingOutreach[]
  watchEvents     WatchEvent[]
  deltaRecordsAsCurrent  DeltaRecord[] @relation("DeltaCurrent")
  deltaRecordsAsPrevious DeltaRecord[] @relation("DeltaPrevious")

  @@index([organizationId, createdAt])
}

/// Append-only audit ledger. Never updated, never deleted while its analysis exists.
model AgentRun {
  id           String    @id @default(cuid())
  analysisId   String
  agent        String
  agentVersion String
  promptId     String?
  model        String?
  inputHash    String
  output       Json?
  status       RunStatus
  warnings     Json      @default("[]")
  tokensIn     Int?
  tokensOut    Int?
  durationMs   Int
  startedAt    DateTime
  finishedAt   DateTime?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, startedAt])
}

model Metric {
  id         String  @id @default(cuid())
  analysisId String
  key        String
  value      Float
  unit       String
  currency   String?
  pillar     String?
  confidence Float   @default(1)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, key])
}

model Insight {
  id                    String   @id @default(cuid())
  analysisId            String
  title                 String
  explanation           String
  severity              Severity
  sourceMetrics         String[] // REQUIRED, non-empty — provenance is an invariant
  evidenceTransactionIds String[]
  displayOrder          Int      @default(0)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Recommendation {
  id                 String   @id @default(cuid())
  analysisId         String
  action             String
  rationale          String
  priority           Int
  effort             Effort
  pillar             String?
  estimatedPointGain Float?
  timeframe          String
  displayOrder       Int      @default(0)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model RiskFlag {
  id                     String   @id @default(cuid())
  analysisId             String
  code                   String
  severity               Severity
  detail                 String
  pointsDeducted         Float    @default(0)
  evidenceTransactionIds String[]

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// ---------------------------------------------------------------------------
// Reports & sharing
// ---------------------------------------------------------------------------

model Report {
  id                String   @id @default(cuid())
  analysisId        String   @unique
  pdfRef            String
  model             Json
  pages             Int
  disclaimerVersion String
  generatedAt       DateTime @default(now())

  analysis   Analysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]
}

// ---------------------------------------------------------------------------
// Agentic loop entities (Phase 1)
// These are the rows the Funding Outreach Agent, Watcher Agent, and Delta
// Agent write to. The system of record grows over time as these accumulate.
// ---------------------------------------------------------------------------

/// A draft funding outreach plan, awaiting business-owner approval.
/// Lifecycle: drafted → approved → shared → viewed → completed | revoked | failed
model FundingOutreach {
  id                  String                 @id @default(cuid())
  analysisId          String
  organizationId      String
  status              FundingOutreachStatus  @default(drafted)

  /// Hardcoded Caribbean funding programs the business may qualify for.
  /// Each entry: { programId, programName, jurisdiction, eligible: bool, ruleMissed?: string }
  eligiblePrograms    Json

  /// LLM-generated outreach plan: { headline, summary, recommendedProgram, nextSteps[] }
  plan                Json

  /// Evidence pack draft (the same data the lender-facing API would serve).
  evidencePack        Json

  /// Approval gate: human-in-the-loop. Required before status can transition to 'shared'.
  approvedAt          DateTime?
  approvedByUserId    String?
  shareLinkId         String?  @unique

  /// The first time a lender accessed the shared link.
  firstViewedAt       DateTime?
  viewCount           Int                    @default(0)
  lastViewedAt        DateTime?

  /// LLM model + tokens used to draft the plan.
  draftedByModel      String?
  draftedAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([analysisId])
}

/// A material change detected by the Watcher Agent between analyses or
/// against the business's historical baseline. Written automatically by the
/// daily morning-check cron; the business gets a Resend email if anything
/// significant is recorded.
model WatchEvent {
  id             String         @id @default(cuid())
  organizationId String
  analysisId     String?

  /// What the watcher noticed. One of: score_drop, score_rise, risk_flag_new,
  /// threshold_crossed, balance_anomaly, recurring_broken.
  eventType       WatchEventType

  /// What it means in plain language. Generated by the LLM, but the numbers
  /// it cites must already exist on the Analysis row.
  summary         String

  /// The metric values that triggered the event. Keyed by metric.key.
  /// E.g. { "score.composite": 63, "score.liquidity": 9 }
  evidence       Json

  /// Was the business owner notified?
  notifiedAt      DateTime?
  notificationChannel String? // "email" | "in_app" | null

  createdAt       DateTime @default(now())

  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([analysisId])
}

/// Written by the Delta Agent when a new analysis is uploaded for a business
/// that already has a previous one. Captures the change so the "system of
/// record over time" story is queryable.
model DeltaRecord {
  id                    String   @id @default(cuid())
  organizationId        String
  currentAnalysisId     String
  previousAnalysisId    String
  scoreDelta            Int      // current.score - previous.score
  bandChanged           Boolean
  previousBand          HealthBand?
  currentBand           HealthBand?

  /// Per-pillar deltas. { "cash_flow_stability": 1, "liquidity_runway": -2, ... }
  pillarDeltas          Json

  /// LLM-generated one-paragraph "what changed" summary. Numeric claims
  /// must match values in the evidence object.
  summary               String

  /// The numbers behind the summary. Same provenance rule as Insight.
  evidence              Json

  createdAt             DateTime @default(now())

  currentAnalysis  Analysis @relation("DeltaCurrent", fields: [currentAnalysisId], references: [id], onDelete: Cascade)
  previousAnalysis Analysis @relation("DeltaPrevious", fields: [previousAnalysisId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ShareLink {
  id             String    @id @default(cuid())
  reportId       String
  token          String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// Append-only. Every access to business financial data, visible to the owner.
model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  actorType      ActorType
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  ipHash         String?
  occurredAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatementStatus {
  uploaded
  validating
  validated
  rejected
}

enum AnalysisStatus {
  queued
  validating
  awaiting_input
  analyzing
  scoring
  interpreting
  reporting
  completed
  degraded
  failed
  validation_failed
}

enum Direction {
  inflow
  outflow
}

enum CategorySource {
  rule
  llm
  user
}

enum CounterpartyType {
  customer
  supplier
  employee
  institution
  internal
  unknown
}

enum Cadence {
  weekly
  biweekly
  monthly
  quarterly
  irregular
}

enum HealthBand {
  Critical
  Fragile
  Watch
  Healthy
  Strong
}

enum FundingTier {
  NotReady
  Building
  NearReady
  Ready
}

enum RunStatus {
  completed
  failed
  skipped
  degraded
}

enum Severity {
  info
  watch
  concern
  critical
}

enum Effort {
  low
  medium
  high
}

enum ActorType {
  user
  partner
  system
}

// ---------------------------------------------------------------------------
// Agentic-loop enums (Phase 1)
// ---------------------------------------------------------------------------

enum MembershipRole {
  owner
  admin
  member
  viewer
}

/// Lifecycle of a FundingOutreach row.
/// drafted → approved (human gate) → shared (link created) → viewed (lender opened) → completed
/// any state may transition to revoked or failed.
enum FundingOutreachStatus {
  drafted
  approved
  shared
  viewed
  completed
  revoked
  failed
}

/// What the Watcher Agent noticed. Each value triggers a different notification template.
enum WatchEventType {
  score_drop
  score_rise
  risk_flag_new
  threshold_crossed
  balance_anomaly
  recurring_broken
  funding_tier_change
}

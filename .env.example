# ---------------------------------------------------------------------------
# VitalFlow environment
# Copy to .env.local and fill in. NEVER commit a filled-in file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://vitalflow:vitalflow@localhost:5432/vitalflow?schema=public"

# --- LLM (OpenAI-compatible) ----------------------------------------------
# Any OpenAI-compatible endpoint. The client is provider-agnostic by design.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.3"
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"

# --- Analysis limits -------------------------------------------------------
MAX_UPLOAD_BYTES="10485760"        # 10 MB
MAX_STATEMENT_ROWS="50000"
MIN_STATEMENT_DAYS="30"
MAX_REJECTED_ROW_RATIO="0.05"
ANALYSIS_TOKEN_BUDGET="60000"

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER="local"             # local | s3
STORAGE_LOCAL_PATH="./storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# --- Retention -------------------------------------------------------------
RAW_FILE_RETENTION_DAYS="30"
SHARE_LINK_TTL_DAYS="14"

# --- Email (Resend) --------------------------------------------------------
# VitalFlow uses Resend (https://resend.com) to deliver Watcher alert
# emails. Both vars are read on the server only and are never exposed
# to the browser. If either is missing, the orchestrator records the
# WatchEvent but does not send (and notedAt stays null).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="noreply@vitalflow.haybee.xyz"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
